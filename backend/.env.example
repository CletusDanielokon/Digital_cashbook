PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cashbook_google?retryWrites=true&w=majority
JWT_SECRET=<a-long-random-string>

# Use a DIFFERENT database name from your other CashBook project (here: cashbook_google)
# so the two projects never share users.

# Google sign-in (Google Cloud Console > Credentials > OAuth client ID)
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com

# Where the frontend is served from (no trailing slash).
# Local: http://127.0.0.1:5500   Deployed: https://your-site.netlify.app
FRONTEND_URL=http://127.0.0.1:5500

# ---------------------------------------------------------------
# EMAIL (verification codes + password reset links)
# Choose ONE option. With none of them, codes are only printed in the server log.
# ---------------------------------------------------------------
# A) Brevo (recommended when deployed on Render: works over HTTPS, free plan 300 emails/day,
#    can email ANY address once your sender address is verified in Brevo)
# BREVO_API_KEY=<xkeysib-...>
# EMAIL_FROM=CashBook <the-address-you-verified-in-brevo@example.com>
#
# B) Resend (its free test sender only delivers to your own Resend account email)
# RESEND_API_KEY=<re_...>
# EMAIL_FROM=CashBook <onboarding@resend.dev>
#
# C) On your own computer only (Render blocks this): Gmail App Password
# EMAIL_USER=<your-gmail-address>
# EMAIL_PASS=<16-character-app-password>

# ---------------------------------------------------------------
# SMS and WhatsApp (verification codes sent to a phone number) - Termii, a Nigerian provider.
# Without it, phone codes are only printed in the server log.
# ---------------------------------------------------------------
# TERMII_API_KEY=<your-termii-api-key>
# TERMII_BASE_URL=<the base URL shown on your Termii dashboard>   (default: https://api.ng.termii.com)
# TERMII_SENDER_ID=CashBook        (must be registered / approved in your Termii account)
# TERMII_CHANNEL=generic           (switch to "dnd" for verification codes once Termii has activated
#                                   the DND route on your account; generic can fail on DND numbers)
#
# Optional: send phone codes on WhatsApp (needs a WhatsApp device and an APPROVED Authentication
# template in your Termii account)
# TERMII_WHATSAPP_DEVICE_ID=<device id from the WhatsApp page of your Termii dashboard>
# TERMII_WHATSAPP_TEMPLATE_ID=<id of your approved authentication template>
# PHONE_CODE_CHANNEL=sms           (sms = text message only [default]
#                                   whatsapp = WhatsApp first, text message if WhatsApp fails
#                                   both = send both)

# Which website may call this API (your Netlify address, no trailing slash).
# Several addresses can be separated by commas. Leave empty for local development.
# CORS_ORIGIN=https://my-cashbook-google.netlify.app
